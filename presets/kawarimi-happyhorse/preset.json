{
  "id": "kawarimi-happyhorse",
  "name": "HappyHorse 1.0 Video Edit",
  "description": "Character swap on HappyHorse 1.0 Video Edit.",
  "category": "video",
  "order": 70,
  "engine": "workflow",
  "model": {
    "id": "happyhorse-edit",
    "label": "HappyHorse 1.0 Video Edit",
    "license": "partner"
  },
  "source": {
    "template": "api_happyhorse1_0_video_edit"
  },
  "inputs": [
    {
      "key": "video",
      "type": "video",
      "label": "Source video",
      "required": true,
      "bind": { "node": "16", "field": "file" }
    },
    {
      "key": "character",
      "type": "image",
      "label": "Character",
      "required": true,
      "bind": { "node": "14", "field": "image" }
    }
  ],
  "params": [
    {
      "type": "text",
      "key": "prompt",
      "label": "Prompt",
      "default": "Replace the person in the video with the character in the image. Keep the motion, camera and background.",
      "bind": { "node": "15", "field": "model.prompt" }
    },
    {
      "type": "choice",
      "key": "resolution",
      "label": "Resolution",
      "default": "720P",
      "options": [
        { "value": "720P", "label": "720P" },
        { "value": "1080P", "label": "1080P" }
      ],
      "bind": { "node": "15", "field": "model.resolution" }
    },
    {
      "type": "seed",
      "key": "seed",
      "label": "Seed",
      "bind": { "node": "15", "field": "seed" }
    }
  ],
  "outputs": [{ "node": "6", "kind": "video" }]
}
