{
  "id": "kawarimi-wan27",
  "name": "Wan 2.7 Video Edit",
  "description": "Character swap on Wan 2.7 Video Edit.",
  "category": "video",
  "order": 60,
  "engine": "workflow",
  "model": {
    "id": "wan27-edit",
    "label": "Wan 2.7 Video Edit",
    "license": "partner"
  },
  "source": {
    "template": "api_wan2_7_video_edit"
  },
  "inputs": [
    {
      "key": "video",
      "type": "video",
      "label": "Source video",
      "required": true,
      "bind": { "node": "1", "field": "file" }
    },
    {
      "key": "character",
      "type": "image",
      "label": "Character",
      "required": true,
      "bind": { "node": "3", "field": "image" }
    }
  ],
  "params": [
    {
      "type": "text",
      "key": "prompt",
      "label": "Prompt",
      "default": "Replace the person with the character from image1. Keep the motion, camera and background unchanged.",
      "bind": { "node": "4", "field": "model.prompt" }
    },
    {
      "type": "choice",
      "key": "resolution",
      "label": "Resolution",
      "default": "720P",
      "options": [
        { "value": "720P", "label": "720P" },
        { "value": "1080P", "label": "1080P" }
      ],
      "bind": { "node": "4", "field": "model.resolution" }
    },
    {
      "type": "seed",
      "key": "seed",
      "label": "Seed",
      "bind": { "node": "4", "field": "seed" }
    }
  ],
  "outputs": [{ "node": "5", "kind": "video" }]
}
