{
  "id": "nano-banana-2",
  "name": "Nano Banana 2",
  "description": "Text to image on Nano Banana 2.",
  "category": "image",
  "order": 4,
  "chip": "1K",
  "engine": "workflow",
  "model": {
    "id": "nano-banana-2",
    "label": "Nano Banana 2",
    "license": "partner"
  },
  "source": {
    "template": "api_google_nano_banana2_text_to_image"
  },
  "inputs": [],
  "params": [
    {
      "type": "text",
      "key": "prompt",
      "label": "Prompt",
      "default": "",
      "placeholder": "Describe the image",
      "bind": {
        "node": "24",
        "field": "prompt"
      }
    },
    {
      "type": "seed",
      "key": "seed",
      "label": "Seed",
      "bind": {
        "node": "24",
        "field": "seed"
      }
    },
    {
      "type": "choice",
      "key": "aspect",
      "label": "Aspect",
      "default": "1:1",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "1:1", "label": "1:1" },
        { "value": "3:2", "label": "3:2" },
        { "value": "2:3", "label": "2:3" },
        { "value": "16:9", "label": "16:9" },
        { "value": "9:16", "label": "9:16" }
      ],
      "bind": {
        "node": "24",
        "field": "model.aspect_ratio"
      }
    },
    {
      "type": "choice",
      "key": "resolution",
      "label": "Resolution",
      "default": "1K",
      "options": [
        { "value": "1K", "label": "1K" },
        { "value": "2K", "label": "2K" },
        { "value": "4K", "label": "4K" }
      ],
      "bind": {
        "node": "24",
        "field": "model.resolution"
      }
    }
  ],
  "outputs": [
    {
      "node": "9",
      "kind": "image"
    }
  ]
}
