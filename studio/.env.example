# Comfy Cloud and Comfy Router key: https://platform.comfy.org/profile/api-keys
COMFY_API_KEY=
# Optional: another Comfy API v2 endpoint (a Comfy API deployment, or comfy-api-proxy in front of your own ComfyUI at http://127.0.0.1:8189). Blank = Comfy Cloud.
COMFY_BASE_URL=
# Hosted mockup: on by default on Vercel, off locally. No generation or server writes.
# Set on locally to preview the demo. Set off only with a real hosted backend.
PHAINO_DEMO=
# Optional path overrides (defaults: ../presets, <PHAINO_DATA_DIR>/forks, ./.data).
# The old CUTAWAY_DATA_DIR / CUTAWAY_USER names still work.
PRESETS_DIR=
FORKS_DIR=
PHAINO_DATA_DIR=
PHAINO_USER=local
# Public origin used for OG metadata (default https://app.phaino.us.ci).
# PHAINO_SITE_URL still works as a legacy fallback.
NEXT_PUBLIC_SITE_URL=
# Optional ffmpeg/ffprobe binaries for sequence export (default: on PATH)
FFMPEG_PATH=
FFPROBE_PATH=
