# Local GPU: comfy-api-proxy in front of your ComfyUI (pip install comfy-api-proxy && comfy-api-proxy)
COMFY_BASE_URL=http://127.0.0.1:8189
# Optional bearer token, only if your proxy is configured with one
COMFY_LOCAL_TOKEN=
# Comfy Cloud and Comfy Router key: https://platform.comfy.org/profile/api-keys
COMFY_API_KEY=
# Optional: a Comfy API deployment URL instead of Comfy Cloud
COMFY_CLOUD_URL=https://cloud.comfy.org
# Optional path overrides (defaults: ../presets, ../forks, ./.data)
PRESETS_DIR=
FORKS_DIR=
CUTAWAY_DATA_DIR=
CUTAWAY_USER=local
