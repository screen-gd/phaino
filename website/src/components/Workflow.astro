---
/* The hero underlay: the graph behind the hero shot, laid out left to right like a ComfyUI canvas.
   Wires are drawn from the measured socket positions, so they stay attached at any size. */
const moves = ['Orbit', 'Dolly in', 'Crash zoom'];
---
<div class="workflow" data-workflow aria-label="Illustrative workflow: a first frame, your direction and a camera move feed LTX 2.5, which renders the shot">
  <svg class="workflow-wires" aria-hidden="true"><g class="base-wires" data-base-wires></g><g class="signal-wires" data-signal-wires></g></svg>

  <div class="workflow-inputs">
    <article class="workflow-node">
      <span class="node-type">INPUT</span>
      <strong>Load image</strong>
      <div class="node-file"><img src="/media/hero.webp" alt="" width="64" height="40" loading="lazy" /><span>first_frame.png</span></div>
      <span class="node-socket out" data-out="image">IMAGE<i></i></span>
    </article>
    <article class="workflow-node">
      <span class="node-type">PROMPT</span>
      <strong>Your direction</strong>
      <span class="node-value">Slow orbit. Hold the subject.</span>
      <span class="node-socket out" data-out="prompt">CONDITIONING<i></i></span>
    </article>
    <article class="workflow-node">
      <span class="node-type">CONTROL</span>
      <strong>Camera motion</strong>
      <span class="node-chips">{moves.map((move, index) => <span class:list={{ active: index === 0 }}>{move}</span>)}</span>
      <span class="node-socket out" data-out="motion">MOTION<i></i></span>
    </article>
  </div>

  <article class="workflow-node generate-node">
    <span class="node-type">GENERATE<span class="node-dot"></span></span>
    <strong>LTX 2.5</strong>
    <span class="node-socket in" data-in="image"><i></i>image</span>
    <span class="node-socket in" data-in="prompt"><i></i>conditioning</span>
    <span class="node-socket in" data-in="motion"><i></i>motion</span>
    <dl class="node-settings"><div><dt>Size</dt><dd>1280 × 720</dd></div><div><dt>Rate</dt><dd>24 fps</dd></div><div><dt>Length</dt><dd>5 s</dd></div></dl>
    <span class="node-socket out" data-out="frames">FRAMES<i></i></span>
  </article>

  <article class="workflow-node output-node">
    <span class="node-type">OUTPUT</span>
    <strong>Your next shot</strong>
    <span class="node-socket in" data-in="frames"><i></i>video</span>
    <figure class="node-preview"><img src="/media/hero.webp" alt="" width="320" height="180" loading="lazy" /><figcaption>orbit_001.mp4</figcaption></figure>
  </article>
</div>

<script>
  const offsetIn = (el: HTMLElement, root: HTMLElement) => {
    let x = el.offsetWidth / 2;
    let y = el.offsetHeight / 2;
    let node: HTMLElement | null = el;
    while (node && node !== root) {
      x += node.offsetLeft;
      y += node.offsetTop;
      node = node.offsetParent as HTMLElement | null;
    }
    return { x, y };
  };

  document.querySelectorAll<HTMLElement>('[data-workflow]').forEach((root) => {
    const base = root.querySelector<SVGGElement>('[data-base-wires]');
    const signal = root.querySelector<SVGGElement>('[data-signal-wires]');
    if (!base || !signal) return;
    const draw = () => {
      const paths = [...root.querySelectorAll<HTMLElement>('[data-out]')].flatMap((out) => {
        const target = root.querySelector<HTMLElement>(`[data-in="${out.dataset.out}"] i`);
        const start = out.querySelector<HTMLElement>('i');
        if (!target || !start) return [];
        const a = offsetIn(start, root);
        const b = offsetIn(target, root);
        const bend = Math.max(40, (b.x - a.x) * .5);
        return [`<path d="M${a.x} ${a.y}C${a.x + bend} ${a.y} ${b.x - bend} ${b.y} ${b.x} ${b.y}" />`];
      }).join('');
      base.innerHTML = paths;
      signal.innerHTML = paths;
    };
    draw();
    document.fonts?.ready.then(draw);
    new ResizeObserver(draw).observe(root);
  });
</script>

<style>
  .workflow { position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: center; column-gap: clamp(44px, 5vw, 96px); max-width: 1040px; width: 100%; justify-self: end; }
  .workflow-wires { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .base-wires { stroke: #ff5b22; stroke-opacity: .28; stroke-width: 1.5; fill: none; }
  .signal-wires { stroke: #ff5b22; stroke-width: 2; stroke-linecap: round; fill: none; stroke-dasharray: 2 16; animation: wire-flow 1.1s linear infinite; }
  @keyframes wire-flow { to { stroke-dashoffset: -18; } }
  .workflow-inputs { display: flex; flex-direction: column; gap: 16px; }

  .workflow-node { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 10px; padding: 12px 14px 14px; border: 1px solid #2a2a2a; border-radius: 14px; background: linear-gradient(180deg, #161616, #0f0f0f); box-shadow: inset 0 1px 0 #ffffff0d, 0 24px 60px #000c; }
  .node-type { display: flex; align-items: center; justify-content: space-between; color: #8a8a8a; font-family: var(--font-mono); font-size: 10px; letter-spacing: .08em; }
  .node-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); }
  .workflow-node strong { margin-top: -4px; font-size: clamp(14px, 1.05vw, 17px); font-weight: 500; letter-spacing: -.025em; }
  .node-value, .node-file { padding: 7px 9px; border: 1px solid #242424; border-radius: 7px; background: #0a0a0a; color: #c4c4c4; font-family: var(--font-mono); font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .node-file { display: flex; align-items: center; gap: 9px; padding: 5px 9px 5px 5px; }
  .node-file img { width: 40px; height: 26px; border-radius: 4px; object-fit: cover; flex: none; }
  .node-chips { display: flex; flex-wrap: wrap; gap: 5px; }
  .node-chips > span { padding: 4px 9px; border: 1px solid #2a2a2a; border-radius: 999px; color: #9a9a9a; font-size: 11px; }
  .node-chips > .active { border-color: var(--accent); color: var(--accent); }

  .node-socket { position: relative; display: flex; align-items: center; gap: 8px; color: #8f8f8f; font-family: var(--font-mono); font-size: 10px; letter-spacing: .04em; }
  .node-socket.out { justify-content: flex-end; }
  .node-socket i { position: absolute; top: 50%; width: 9px; height: 9px; margin-top: -4.5px; border: 1.5px solid var(--accent); border-radius: 50%; background: #0b0b0b; }
  .node-socket.out i { right: -19.5px; }
  .node-socket.in i { left: -19.5px; }
  .node-socket.in { color: #b8b8b8; }

  .node-settings { display: grid; gap: 6px; margin: 4px 0 0; padding-top: 10px; border-top: 1px solid #222; }
  .node-settings > div { display: flex; justify-content: space-between; gap: 12px; font-size: 11px; }
  .node-settings dt { color: #7d7d7d; }
  .node-settings dd { margin: 0; color: #ddd; font-family: var(--font-mono); }

  .output-node { border-color: #ff5b2250; box-shadow: inset 0 1px 0 #ffffff0d, 0 0 0 1px #ff5b221a, 0 30px 90px #ff5b2214; }
  .node-preview { position: relative; margin: 2px 0 0; overflow: hidden; aspect-ratio: 16 / 9; border-radius: 8px; background: #0a0a0a; }
  .node-preview img { width: 100%; height: 100%; object-fit: cover; }
  .node-preview figcaption { position: absolute; left: 8px; bottom: 7px; padding: 3px 7px; border-radius: 999px; background: #000000b0; color: #eee; font-family: var(--font-mono); font-size: 10px; }

  @media (prefers-reduced-motion: reduce) { .signal-wires { animation: none; } }
  :global(html[data-motion-paused]) .signal-wires { animation: none; }
</style>
