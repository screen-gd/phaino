// Cloudflare Workers deploy for the static marketing site. Declaring the assets
// directory here stops `wrangler deploy` from auto-adding the Astro Cloudflare adapter;
// the site is fully static, so no server runtime is needed.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "phaino",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
